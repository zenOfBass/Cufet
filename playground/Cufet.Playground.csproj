<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Cufet interpreter, compiled to WebAssembly.

    Deliberately NOT a Blazor project. Blazor is a UI framework — renderer, router, DI,
    component model — and none of that is wanted here: the page is Monaco plus a Run button,
    so all this needs to be is "call C# from JavaScript". A plain browser-wasm project with
    [JSExport] does exactly that, ships less, and avoids the SPA-routing workaround Blazor
    apps need on GitHub Pages.

    The compiler backend is NOT referenced. It shells out to gcc, which has no meaning in a
    browser, and leaving it out keeps the payload to the front end plus the interpreter.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      The SDK's entry script. It is named worker.js because that is where it runs: the page
      spawns it as a Web Worker rather than loading it itself, so a synchronous Cufet program
      cannot freeze the UI thread. The SDK only copies this file; it does not care which thread
      ends up evaluating it.
    -->
    <WasmMainJSPath>worker.js</WasmMainJSPath>

    <!-- Payload is the whole point of this project's first cut, so trim hard and measure. -->
    <PublishTrimmed>true</PublishTrimmed>
    <EventSourceSupport>false</EventSourceSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>

    <!--
      InvariantGlobalization is DELIBERATELY ABSENT, and it is not an oversight.

      Setting it forces emscripten to relink the native runtime instead of using the prebuilt
      dotnet.native.wasm — and that relink cannot handle a space in the build path. This
      repository lives under "…\My Stuff\…", so turning it on fails locally with a wasm-ld
      "cannot open output file" that names a directory which demonstrably exists. Bisected:
      the same project builds with it in a space-free path, and builds without it here.

      It WOULD shrink the payload (ICU data is a real chunk of it), and a CI runner has no
      spaces in its checkout path, so a publish workflow can turn it back on. Measure the
      difference before deciding it matters.
    -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\Interpreter\Cufet.Interpreter.csproj" />

    <!--
      ⚠⚠ The interpreter is ROOTED, and it is load-bearing rather than cautious.

      Trimming strips PARAMETER NAMES. Measured on the published assembly: ObjectDefinition's
      twelve-parameter constructor comes out of the linker with four unnamed rows. The front end
      rebuilds AST nodes by matching constructor parameters to properties BY NAME (AstRebuilder,
      and the same reflective shape in AstSearch and StashTransform), so once the names are gone
      every rebuild throws — and the message carries the name it could not find, which is why the
      playground answered a nine-line average with "ObjectDefinition. has no matching property",
      an empty name where a name should be.

      That reached everything the front end rewrites: generics, stashes and cufet blocks. Not a
      hypothetical — it was how the playground behaved.

      ★ MEASURED, on a clean publish each time, because an incremental one silently reuses the
      old link and reports success:
          trimmed (broken)   9,385,690 bytes
          rooted   (works)   9,593,123 bytes    +207,433, or 2.2%
      `TrimMode=partial` was tried alongside and is NOT needed — rooting alone preserves the names,
      and adding it cost a further 12,721 bytes for nothing. The payload lives in the runtime and
      the ICU data, not in this assembly.
    -->
    <TrimmerRootAssembly Include="Cufet.Interpreter" />
  </ItemGroup>

</Project>
