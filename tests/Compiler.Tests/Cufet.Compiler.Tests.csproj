<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.6.0" />
    <PackageReference Include="xunit" Version="2.4.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Compiler\Cufet.Compiler.csproj" />
    <ProjectReference Include="..\..\src\Interpreter\Cufet.Interpreter.csproj" />
  </ItemGroup>

  <!-- Soundness probe programs, run as fixtures by SoundnessFixtureTests. Copied next to the
       test assembly so the tests find them by directory enumeration (see that file for the
       filename convention that encodes each probe's expected outcome). -->
  <ItemGroup>
    <Content Include="..\fixtures\soundness\*.cufe"
             Link="fixtures\soundness\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
