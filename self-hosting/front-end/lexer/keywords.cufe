/*  The words Cufet has taken, and the token each one becomes.

    ★ Copied from the switch in `src/Lexer/Lexer.cs` (`ReadWord`), in its order. The parity test
    compares this lexer's tokens with that one's over every file in the repository, so a word added
    there and not here fails the test rather than drifting quietly.

    ⚠ The token names are the C# enum's, spelled exactly — they are what the test compares.
*/
Bind map from text to text to keyword-table:
    Return a map with (
        "it" : "It",
        "a" : "Article",
        "an" : "Article",
        "the" : "Article",
        "state" : "State",
        "define" : "Define",
        "as" : "As",
        "becomes" : "Becomes",
        "if" : "If",
        "otherwise" : "Otherwise",
        "when" : "When",
        "judge" : "Judge",
        "where" : "Where",
        "done" : "Done",
        "is" : "Is",
        "not" : "Not",
        "greater" : "Greater",
        "less" : "Less",
        "than" : "Than",
        "or" : "Or",
        "and" : "And",
        "xor" : "Xor",
        "more" : "More",
        "while" : "While",
        "repeat" : "Repeat",
        "until" : "Until",
        "stop" : "Stop",
        "skip" : "Skip",
        "series" : "Series",
        "record" : "Record",
        "with" : "With",
        "like" : "Like",
        "object" : "Object",
        "interface" : "Interface",
        "new" : "New",
        "one" : "One",
        "for" : "For",
        "each" : "Each",
        "in" : "In",
        "item" : "Item",
        "of" : "Of",
        "number" : "NumberKw",
        "increment" : "Increment",
        "decrement" : "Decrement",
        "insert" : "Insert",
        "into" : "Into",
        "to" : "To",
        "start" : "Start",
        "after" : "After",
        "remove" : "Remove",
        "from" : "From",
        "bind" : "Bind",
        "cast" : "Cast",
        "given" : "Given",
        "return" : "Return",
        "void" : "Void",
        "bury" : "Bury",
        "unbury" : "Unbury",
        "stash" : "Stash",
        "on" : "On",
        "function" : "FunctionKw",
        "joined" : "Joined",
        "converted" : "Converted",
        "range" : "Range",
        "counting" : "Counting",
        "by" : "By",
        "permanently" : "Permanently",
        "shadow" : "Shadow",
        "voidable" : "Voidable",
        "but" : "But",
        "map" : "Map",
        "has" : "Has",
        "position" : "Position",
        "split" : "Split",
        "contains" : "Contains",
        "end" : "End",
        "replace" : "Replace",
        "uppercase" : "Uppercase",
        "lowercase" : "Lowercase",
        "trimmed" : "Trimmed",
        "shifted" : "Shifted",
        "sorted" : "Sorted",
        "reverse" : "Reverse",
        "unto" : "Unto",
        "get" : "GetKw",
        "set" : "SetKw",
        "making" : "MakingKw",
        "unmaking" : "UnmakingKw",
        "overloading" : "OverloadingKw",
        "failure" : "Failure",
        "category" : "Category",
        "try" : "Try",
        "case" : "Case",
        "pass" : "Pass",
        "off" : "Off",
        "exception" : "Exception",
        "suppress" : "Suppress",
        "file" : "File",
