/*  How the checker says things — `TypeError`, `FormatType` and `FormatExpr` in
    `src/Interpreter/TypeChecker.Core.cs`.

    ★ Every refusal is built by `refusal-of`, in the one shape `TypeError` gives them all:

        That doesn't work: <context>.
        <what was established>.                  (only when there is something to say)
        Here on line <n>, you're trying to <action>.

        <what to do>

    and handed back as a failure whose message is `error\t` and those words.
*/

Pull a book on collections.
    /// The C# checker's refusal, as a failure message. An empty `established` says nothing there.
    Bind text to refusal-of, given (the text context, the text established, the number at-row,
            the text action, the text fix):
        Define settled as "".
        If established is not "", the settled becomes "\n{established}.".
        Return "error\tThat doesn't work: {context}.{settled}\nHere on line {at-row}, you're trying to {action}.\n\n{fix}".
    Done.

    /// A voidable used where only a value that is there will do — C#'s `VoidableMisuse`, the one
    /// refusal every such site gives. `example` is the line written the way that works; `note`,
    /// when not empty, is one more line of advice.
    Bind text to void-misuse, given (the node said, the text needs, the text action, the text example,
            the number at-row, the text note):
        Define spoken as cast expression-words on (said).
        Define fix as "Say what to use when it is void: {example}.".
        If note is not "", the fix becomes "{fix}\n{note}".
        If said's kind is "VariableReference", the fix becomes "{fix}\nOr check first, with 'If {spoken} is not void:'.".
        Return cast refusal-of on ("'{spoken}' might be void, and {needs}", "", at-row, action, fix).
    Done.

    /// `<expr> but void is <a default>` — what a void-misuse example is built from.
    Bind text to defaulted, given (the node said, the node inner):
        Define fallback as "<a {cast type-words on (inner)}>".
        If inner's kind is "NumberType", the fallback becomes "0".
        If inner's kind is "TextType", the fallback becomes "\"\"".
        If inner's kind is "FactType", the fallback becomes "false".
        Return "{cast expression-words on (said)} but void is {fallback}".
    Done.

    /// What the checker cannot judge yet, as a failure message.
    Bind text to not-judged, given (the text what):
        Return "unsupported\t{what}".
    Done.

    // ── Reading the tree ──────────────────────────────────────────────────

    /// A node's `n`th field.
    Bind node to field-of, given (the node whole, the number place):
        Return item place of whole's children.
    Done.

    /// The text a quoted leaf holds — the reverse of `quoted` in tree.cufe.
    Bind text to unquoted, given (the node leaf):
        Define letters as a chase.
        Insert leaf's word into letters.
        Define out as a chase.
        Define place as 2.
        Define last as the number of letters - 1.
        While place is less than last + 1, repeat:
            Define ch as item place of letters.
            If ch is "\\" and place is less than last:
                Increment place by 1.
                Define escape as item place of letters.
                The ch becomes escape.
                If escape is "n", the ch becomes "\n".
                If escape is "t", the ch becomes "\t".
                If escape is "r", the ch becomes "\r".
            Done.
            Insert ch into out.
            Increment place by 1.
        Done.
        Return out converted to text.
    Done.

    /// A number field, read back from its leaf.
    Bind number to numeric, given (the node leaf):
        Return (leaf's word converted to number but void is 0).
    Done.

    /// A fact field, read back from its leaf.
    Bind fact to truth-of, given (the node leaf):
        Return leaf's word is "true".
    Done.

    /// Is this field empty — the `_` the printer writes for nothing?
    Bind fact to is-nothing, given (the node leaf):
        Return leaf's kind is "atom" and leaf's word is "_".
    Done.

    // ── Types, in words ───────────────────────────────────────────────────

    Bind text to type-words, given (the node shape):
        Define kind as shape's kind.
        Judge kind, where it is:
            "NumberType", return "number".
            "BitsType", return "bits".
            "TextType", return "text".
            "FactType", return "fact".
            "VoidType", return "void".
            "AddressType", return "address".
            "FailureMarkerType", return "failure".
            "MappingType", return "mapping".
            "ExceptionMarkerType", return "exception".
            "MatrixType", return "matrix".
            "ChaseType", return "chase".
            "VoidableType", return "voidable {cast type-words on (cast field-of on (shape, 1))}".
            "SeriesType", return "series of {cast plural-words on (cast field-of on (shape, 1))}".
            "StashType", return "stash of {cast plural-words on (cast field-of on (shape, 1))}".
            "SetType", return "set of {cast type-words on (cast field-of on (shape, 1))}".
            "ChannelType", return "channel of {cast type-words on (cast field-of on (shape, 1))}".
            "TaskHandleType":
                If cast is-nothing on (cast field-of on (shape, 1)), return "void task".
                Return "task (result: {cast type-words on (cast field-of on (shape, 1))})".
            Done.
            "MapType":
                Return "map from {cast type-words on (cast field-of on (shape, 1))} to {cast type-words on (cast field-of on (shape, 2))}".
            Done.
            "FunctionType", return cast function-words on (shape).
            "ObjectType":
                If cast is-filled-type on (shape), return cast filled-type-name on (shape).
                Return cast display-name on (cast unquoted on (cast field-of on (shape, 1))).
            Done.
            "InterfaceType", return cast unquoted on (cast field-of on (shape, 1)).
            "AxiomType", return cast axiom-words on (shape).
            "RecordType", return cast record-words on (shape).
            "UnionType", return cast union-words on (shape).
            "FailureType", return "{cast type-words on (cast field-of on (shape, 1))} or failure".
            "ReadableStreamType", return "readable stream of {cast plural-words on (cast field-of on (shape, 1))}".
            "WritableStreamType", return "writable stream of {cast plural-words on (cast field-of on (shape, 1))}".
            Otherwise, return "<unknown>".
        Done.
    Done.

    /// `FormatAxiomType`: `c-language number axiom given (text)`.
    Bind text to axiom-words, given (the node shape):
        Define language as cast unquoted on (cast field-of on (shape, 1)).
        Define head as "{language} axiom".
        If cast is-nothing on (cast field-of on (shape, 2)) is false, the head becomes "{language} {cast type-words on (cast field-of on (shape, 2))} axiom".
        Define taken as (cast field-of on (shape, 3))'s children.
        If the number of taken is 0, return head.
        Define listing as "".
        For each one-type in taken, repeat:
            If listing is not "", the listing becomes listing joined to ", ".
            The listing becomes listing joined to cast type-words on (one-type).
        Done.
        Return "{head} given ({listing})".
    Done.

    Bind text to plural-words, given (the node shape):
        Define kind as shape's kind.
        Judge kind, where it is:
            "NumberType", return "numbers".
            "BitsType", return "bits".
            "TextType", return "text".
            "FactType", return "facts".
            "VoidType", return "void values".
            "MatrixType", return "matrices".
            "FailureMarkerType", return "failures".
            "MappingType", return "mappings".
            "ExceptionMarkerType", return "exceptions".
            "VoidableType", return "voidable {cast plural-words on (cast field-of on (shape, 1))}".
            "SeriesType", return "series of {cast plural-words on (cast field-of on (shape, 1))}".
            "StashType", return "stashes of {cast plural-words on (cast field-of on (shape, 1))}".
            "SetType", return "sets of {cast type-words on (cast field-of on (shape, 1))}".
            "ChannelType", return "channels of {cast plural-words on (cast field-of on (shape, 1))}".
            "TaskHandleType":
                If cast is-nothing on (cast field-of on (shape, 1)), return "void task handles".
                Return "task handles (result: {cast plural-words on (cast field-of on (shape, 1))})".
            Done.
            "MapType":
                Return "maps from {cast type-words on (cast field-of on (shape, 1))} to {cast type-words on (cast field-of on (shape, 2))}".
            Done.
            "FunctionType", return "functions".
            "ObjectType":
                If cast is-filled-type on (shape), return "{cast filled-type-name on (shape)} objects".
                Return "{cast display-name on (cast unquoted on (cast field-of on (shape, 1)))} objects".
            Done.
            "InterfaceType", return "{cast unquoted on (cast field-of on (shape, 1))} values".
            "RecordType", return cast record-words on (shape).
            "UnionType", return "{cast union-words on (shape)} values".
            "FailureType", return "{cast plural-words on (cast field-of on (shape, 1))} or failures".
            "ReadableStreamType", return "readable streams of {cast plural-words on (cast field-of on (shape, 1))}".
            "WritableStreamType", return "writable streams of {cast plural-words on (cast field-of on (shape, 1))}".
            Otherwise, return "<unknown>".
        Done.
    Done.

    /// An expression, quoted back to the writer — `<expression>` for anything not worth quoting.
    /// ⚠ A number is quoted in its shortest form, where C# keeps the scale it was written with:
    /// `1.50` comes back as `1.5` here. The tree holds no more than that.
    Bind text to expression-words, given (the node said):
        Define kind as said's kind.
        Judge kind, where it is:
            "NumberLiteral", return cast field-of on (said, 1)'s word.
            "StringLiteral", return "\"{cast unquoted on (cast field-of on (said, 1))}\"".
            "VariableReference", return cast unquoted on (cast field-of on (said, 1)).
            "VoidLiteral", return "void".
            "NumberConvert", return "{cast expression-words on (cast field-of on (said, 1))} converted to number".
            "PossessiveAccess":
                Return "{cast expression-words on (cast field-of on (said, 1))}'s {cast unquoted on (cast field-of on (said, 2))}".
            Done.
            "MapLookup":
                Return "the entry for {cast expression-words on (cast field-of on (said, 2))} in {cast expression-words on (cast field-of on (said, 1))}".
            Done.
            "CastExpression":
                Define callee as cast field-of on (said, 1).
                Define listing as a chase.
                Define first-one as true.
                For each argument in (cast field-of on (said, 2))'s children, repeat:
                    If first-one is false, insert ", " into listing.
                    The first-one becomes false.
                    Insert cast expression-words on (argument) into listing.
                Done.
                // A bundled book's member is written `math's square-root of (x)`, and quoted back so.
                If callee's kind is "PossessiveAccess":
                    Define owner as cast field-of on (callee, 1).
                    If owner's kind is "VariableReference" and cast is-a-book on (cast unquoted on (cast field-of on (owner, 1))):
                        Return "{cast expression-words on (callee)} of ({listing converted to text})".
                    Done.
                Done.
                Return "cast {cast expression-words on (callee)} on ({listing converted to text})".
            Done.
            "TextFind":
                Return "the position of {cast expression-words on (cast field-of on (said, 1))} in {cast expression-words on (cast field-of on (said, 2))}".
            Done.
            // In its own base and width, as it was written.
            "BitsLiteral", return cast bits-words on (said).
            Otherwise, return "<expression>".
        Done.
    Done.

    /// An operator as a refusal names it.
    Bind text to operator-words, given (the text op):
        Judge op, where it is:
            "Plus", return "+".
            "Minus", return "-".
            "Star", return "*".
            "Slash", return "/".
            "Percent", return "%".
            Otherwise, return op in lowercase.
        Done.
    Done.
Done.
