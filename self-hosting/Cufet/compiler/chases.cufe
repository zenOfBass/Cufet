/*  Chases — `a chase`, `Insert … into` (text, or a number as a code point; at the end, the start, or
    after a place), `item … of`, `the number of`, setting and removing a character, `For each`,
    `converted to text`, and comparing two.

    ★ A chase is SHARED, as a series is: a pointer to code points, UTF-32 inside and UTF-8 at its
      edges, so `item n of` is a subscript. Its C — `CufetChase` and what works on it — is written
      into every program, used or not, as the series helpers are; it is the C `cufet build` writes
      for one, lifted from `CodeGenerator.Runtime.cs` by a script rather than retyped.

    ⚠ `sorted` waits, as it does for a series.
*/

Pull a book on collections.
    /// The C every chase works through.
    Bind text to c-chase-runtime:
        Define out as a chase.
        Insert "typedef struct \{ int32_t* data; int len; int cap; \} CufetChase;\n" into out.
        Insert "\n" into out.
        Insert "static CufetChase* cufet_chase_new(void) \{\n" into out.
        Insert "    CufetChase* c = (CufetChase*)cufet_arena_alloc(sizeof(CufetChase));\n" into out.
        Insert "    c->len = 0; c->cap = 16;\n" into out.
        Insert "    c->data = (int32_t*)cufet_arena_alloc(sizeof(int32_t) * (size_t)c->cap);\n" into out.
        Insert "    return c;\n" into out.
        Insert "\}\n" into out.
        Insert "\n" into out.
        Insert "static void cufet_chase_push(CufetChase* c, int32_t point) \{\n" into out.
        Insert "    if (c->len == c->cap) \{\n" into out.
        Insert "        int grown = c->cap * 2;\n" into out.
        Insert "        int32_t* moved = (int32_t*)cufet_arena_alloc(sizeof(int32_t) * (size_t)grown);\n" into out.
        Insert "        memcpy(moved, c->data, sizeof(int32_t) * (size_t)c->len);\n" into out.
        Insert "        c->data = moved; c->cap = grown;\n" into out.
        Insert "    \}\n" into out.
        Insert "    c->data[c->len++] = point;\n" into out.
        Insert "\}\n" into out.
        Insert "\n" into out.
        Insert "/* Appends every character of a UTF-8 text. A malformed byte is taken as one character rather\n" into out.
        Insert "   than rejected: the lexer only ever hands over well-formed text, and a buffer is the wrong\n" into out.
        Insert "   place to discover otherwise. */\n" into out.
        Insert "static void cufet_chase_append(CufetChase* c, const char* text) \{\n" into out.
        Insert "    const unsigned char* p = (const unsigned char*)text;\n" into out.
        Insert "    while (*p) \{\n" into out.
        Insert "        int32_t point; int extra;\n" into out.
        Insert "        if      (*p < 0x80) \{ point = *p;        extra = 0; \}\n" into out.
        Insert "        else if ((*p & 0xE0) == 0xC0) \{ point = *p & 0x1F; extra = 1; \}\n" into out.
        Insert "        else if ((*p & 0xF0) == 0xE0) \{ point = *p & 0x0F; extra = 2; \}\n" into out.
        Insert "        else if ((*p & 0xF8) == 0xF0) \{ point = *p & 0x07; extra = 3; \}\n" into out.
        Insert "        else \{ point = *p; extra = 0; \}\n" into out.
        Insert "        p++;\n" into out.
        Insert "        for (int i = 0; i < extra && (*p & 0xC0) == 0x80; i++) \{ point = (point << 6) | (*p & 0x3F); p++; \}\n" into out.
        Insert "        cufet_chase_push(c, point);\n" into out.
        Insert "    \}\n" into out.
        Insert "\}\n" into out.
        Insert "\n" into out.
        Insert "/* How many bytes one code point needs in UTF-8. */\n" into out.
        Insert "static int cufet_utf8_width(int32_t point) \{\n" into out.
        Insert "    if (point < 0x80) return 1;\n" into out.
        Insert "    if (point < 0x800) return 2;\n" into out.
        Insert "    if (point < 0x10000) return 3;\n" into out.
        Insert "    return 4;\n" into out.
        Insert "\}\n" into out.
        Insert "\n" into out.
        Insert "static char* cufet_utf8_put(char* out, int32_t point) \{\n" into out.
        Insert "    if (point < 0x80) \{ *out++ = (char)point; return out; \}\n" into out.
        Insert "    if (point < 0x800) \{\n" into out.
        Insert "        *out++ = (char)(0xC0 | (point >> 6));\n" into out.
        Insert "        *out++ = (char)(0x80 | (point & 0x3F));\n" into out.
        Insert "        return out;\n" into out.
        Insert "    \}\n" into out.
        Insert "    if (point < 0x10000) \{\n" into out.
        Insert "        *out++ = (char)(0xE0 | (point >> 12));\n" into out.
        Insert "        *out++ = (char)(0x80 | ((point >> 6) & 0x3F));\n" into out.
        Insert "        *out++ = (char)(0x80 | (point & 0x3F));\n" into out.
        Insert "        return out;\n" into out.
        Insert "    \}\n" into out.
        Insert "    *out++ = (char)(0xF0 | (point >> 18));\n" into out.
        Insert "    *out++ = (char)(0x80 | ((point >> 12) & 0x3F));\n" into out.
        Insert "    *out++ = (char)(0x80 | ((point >> 6) & 0x3F));\n" into out.
        Insert "    *out++ = (char)(0x80 | (point & 0x3F));\n" into out.
        Insert "    return out;\n" into out.
        Insert "\}\n" into out.
        Insert "\n" into out.
        Insert "/* The explicit COPY `converted to text` makes. The buffer lives on, independent. */\n" into out.
        Insert "static const char* cufet_chase_text(CufetChase* c) \{\n" into out.
        Insert "    size_t need = 1;\n" into out.
        Insert "    for (int i = 0; i < c->len; i++) need += (size_t)cufet_utf8_width(c->data[i]);\n" into out.
        Insert "    char* out = (char*)cufet_arena_alloc(need);\n" into out.
        Insert "    char* at = out;\n" into out.
        Insert "    for (int i = 0; i < c->len; i++) at = cufet_utf8_put(at, c->data[i]);\n" into out.
        Insert "    *at = 0;\n" into out.
        Insert "    return out;\n" into out.
        Insert "\}\n" into out.
        Insert "\n" into out.
        Insert "/* Printed as the COLLECTION it is — `(h, e, l, l, o)` — never as the text it will become. */\n" into out.
        Insert "/* Sets one position, and REFUSES a text that is not exactly one character.\n" into out.
        Insert "\n" into out.
        Insert "   ⚠ A length check at run time rather than a type error, because a text's length is not known\n" into out.
        Insert "   until it exists. The alternative — taking the first character and dropping the rest — is the\n" into out.
        Insert "   silent resolution this language refuses everywhere else; setting one position to \"abc\" is a\n" into out.
        Insert "   mistake, not an abbreviation. Insert is the operation that takes however many. */\n" into out.
        Insert "static void cufet_chase_set(CufetChase* c, int index1, const char* one, int line) \{\n" into out.
        Insert "    CufetChase* scratch = cufet_chase_new();\n" into out.
        Insert "    cufet_chase_append(scratch, one);\n" into out.
        Insert "    if (scratch->len != 1)\n" into out.
        Insert "        cufet_raise(cufet_msgf(\n" into out.
        Insert "            \"Setting one position needs exactly one character, and \\\"%s\\\" is %d. This happened on line %d.\",\n" into out.
        Insert "            one, scratch->len, line));\n" into out.
        Insert "    c->data[index1 - 1] = scratch->data[0];\n" into out.
        Insert "\}\n" into out.
        Insert "\n" into out.
        Insert "/* Takes one character out and closes the gap. -1 means the last, matching the series form. */\n" into out.
        Insert "static void cufet_chase_remove_at(CufetChase* c, long long index1, const char* name, int line) \{\n" into out.
        Insert "    int at = (index1 < 0)\n" into out.
        Insert "        ? (int)cufet_last_check(c->len, name, line)\n" into out.
        Insert "        : (int)cufet_idx_check(index1, c->len, name, line);\n" into out.
        Insert "    memmove(&c->data[at - 1], &c->data[at], sizeof(int32_t) * (size_t)(c->len - at));\n" into out.
        Insert "    c->len--;\n" into out.
        Insert "\}\n" into out.
        Insert "\n" into out.
        Insert "/* A number as a code point, or a failure naming which way it is not one. ⚠ The checker refuses a\n" into out.
        Insert "   written-out bad value, so arriving here means the number was computed — and the wording matches\n" into out.
        Insert "   the static message deliberately, so a reader sees one message either way. */\n" into out.
        Insert "static int32_t cufet_code_point(CufetDec point, int line) \{\n" into out.
        Insert "    /* Whole means no fractional part once trailing zeros are gone — `cufet_dec_strip` is what\n" into out.
        Insert "       decides that everywhere else, so it decides it here too rather than a second rule. */\n" into out.
        Insert "    if (cufet_dec_strip(point).scale != 0)\n" into out.
        Insert "        cufet_raise(cufet_msgf(\"%s is not a code point, because it is not a whole number (line %d).\",\n" into out.
        Insert "                               cufet_text_from_dec(point), line));\n" into out.
        Insert "    long long n = cufet_to_int(point);\n" into out.
        Insert "    if (n < 0 || n > 0x10FFFF)\n" into out.
        Insert "        cufet_raise(cufet_msgf(\"%lld is outside the range of a code point — they run from 0 to U+10FFFF (line %d).\",\n" into out.
        Insert "                               n, line));\n" into out.
        Insert "    if (n >= 0xD800 && n <= 0xDFFF)\n" into out.
        Insert "        cufet_raise(cufet_msgf(\"%lld is half of a character, not one — surrogates only mean anything in pairs (line %d).\",\n" into out.
        Insert "                               n, line));\n" into out.
        Insert "    return (int32_t)n;\n" into out.
        Insert "\}\n" into out.
        Insert "\n" into out.
        Insert "/* One code point in, at a 0-based position. ⚠ `at` equal to the length appends. */\n" into out.
        Insert "static void cufet_chase_insert_point(CufetChase* c, int at, int32_t point) \{\n" into out.
        Insert "    int moved = c->len - at;\n" into out.
        Insert "    cufet_chase_push(c, 0);\n" into out.
        Insert "    memmove(&c->data[at + 1], &c->data[at], sizeof(int32_t) * (size_t)moved);\n" into out.
        Insert "    c->data[at] = point;\n" into out.
        Insert "\}\n" into out.
        Insert "\n" into out.
        Insert "/* Inserts every character of a text at a 0-based position, shifting what follows. ⚠ `at` equal to\n" into out.
        Insert "   the length appends, which is what makes the plain form and the positional forms one helper. */\n" into out.
        Insert "static void cufet_chase_insert(CufetChase* c, int at, const char* text) \{\n" into out.
        Insert "    CufetChase* incoming = cufet_chase_new();\n" into out.
        Insert "    cufet_chase_append(incoming, text);\n" into out.
        Insert "    if (incoming->len == 0) return;\n" into out.
        Insert "\n" into out.
        Insert "    int moved = c->len - at;\n" into out.
        Insert "    for (int i = 0; i < incoming->len; i++) cufet_chase_push(c, 0);   /* grow, then shift */\n" into out.
        Insert "    memmove(&c->data[at + incoming->len], &c->data[at], sizeof(int32_t) * (size_t)moved);\n" into out.
        Insert "    memcpy(&c->data[at], incoming->data, sizeof(int32_t) * (size_t)incoming->len);\n" into out.
        Insert "\}\n" into out.
        Insert "\n" into out.
        Insert "/* Takes the FIRST occurrence of one character out, by value. The one-character rule is the same\n" into out.
        Insert "   one setting a position follows, and for the same reason: a text's length is not known until it\n" into out.
        Insert "   exists, and keeping its first character would be the silent resolution this language refuses. */\n" into out.
        Insert "static void cufet_chase_remove_value(CufetChase* c, const char* one, const char* name, int line) \{\n" into out.
        Insert "    CufetChase* scratch = cufet_chase_new();\n" into out.
        Insert "    cufet_chase_append(scratch, one);\n" into out.
        Insert "    if (scratch->len != 1)\n" into out.
        Insert "        cufet_raise(cufet_msgf(\n" into out.
        Insert "            \"'Remove' from a chase takes exactly one character, and \\\"%s\\\" is %d. This happened on line %d.\",\n" into out.
        Insert "            one, scratch->len, line));\n" into out.
        Insert "    for (int i = 0; i < c->len; i++) \{\n" into out.
        Insert "        if (c->data[i] != scratch->data[0]) continue;\n" into out.
        Insert "        memmove(&c->data[i], &c->data[i + 1], sizeof(int32_t) * (size_t)(c->len - i - 1));\n" into out.
        Insert "        c->len--;\n" into out.
        Insert "        return;\n" into out.
        Insert "    \}\n" into out.
        Insert "    cufet_raise(cufet_msgf(\"Character not found in %s on line %d.\", name, line));\n" into out.
        Insert "\}\n" into out.
        Insert "\n" into out.
        Insert "/* A sorted COPY, by code point. ⚠ The unit is the point rather than the rendered character, which\n" into out.
        Insert "   is what keeps this identical to the interpreter — it orders the same integers. */\n" into out.
        Insert "static CufetChase* cufet_chase_sorted(CufetChase* c, int reverse) \{\n" into out.
        Insert "    CufetChase* out = cufet_chase_new();\n" into out.
        Insert "    for (int i = 0; i < c->len; i++) cufet_chase_push(out, c->data[i]);\n" into out.
        Insert "    for (int a = 1; a < out->len; a++) \{\n" into out.
        Insert "        int32_t key = out->data[a];\n" into out.
        Insert "        int j = a - 1;\n" into out.
        Insert "        while (j >= 0 && (reverse ? out->data[j] < key : out->data[j] > key)) \{\n" into out.
        Insert "            out->data[j + 1] = out->data[j];\n" into out.
        Insert "            j--;\n" into out.
        Insert "        \}\n" into out.
        Insert "        out->data[j + 1] = key;\n" into out.
        Insert "    \}\n" into out.
        Insert "    return out;\n" into out.
        Insert "\}\n" into out.
        Insert "\n" into out.
        Insert "/* One character out, as the one-character TEXT the language calls a character. Four bytes plus a\n" into out.
        Insert "   terminator is the most any code point needs. */\n" into out.
        Insert "static const char* cufet_chase_at(CufetChase* c, int index1) \{\n" into out.
        Insert "    char* out = (char*)cufet_arena_alloc(5);\n" into out.
        Insert "    char* at = cufet_utf8_put(out, c->data[index1 - 1]);\n" into out.
        Insert "    *at = 0;\n" into out.
        Insert "    return out;\n" into out.
        Insert "\}\n" into out.
        Insert "\n" into out.
        Insert "/* Structural, matching the interpreter: a buffer of the same characters is the same buffer. */\n" into out.
        Insert "static int cufet_chase_eq(CufetChase* a, CufetChase* b) \{\n" into out.
        Insert "    if (a == b) return 1;\n" into out.
        Insert "    if (!a || !b || a->len != b->len) return 0;\n" into out.
        Insert "    for (int i = 0; i < a->len; i++) if (a->data[i] != b->data[i]) return 0;\n" into out.
        Insert "    return 1;\n" into out.
        Insert "\}\n" into out.
        Insert "\n" into out.
        Insert "static const char* cufet_chase_show(CufetChase* c) \{\n" into out.
        Insert "    size_t need = 3;\n" into out.
        Insert "    for (int i = 0; i < c->len; i++) need += (size_t)cufet_utf8_width(c->data[i]) + 2;\n" into out.
        Insert "    char* out = (char*)cufet_arena_alloc(need);\n" into out.
        Insert "    char* at = out;\n" into out.
        Insert "    *at++ = 40;\n" into out.
        Insert "    for (int i = 0; i < c->len; i++) \{\n" into out.
        Insert "        if (i > 0) \{ *at++ = 44; *at++ = 32; \}\n" into out.
        Insert "        at = cufet_utf8_put(at, c->data[i]);\n" into out.
        Insert "    \}\n" into out.
        Insert "    *at++ = 41;\n" into out.
        Insert "    *at = 0;\n" into out.
        Insert "    return out;\n" into out.
        Insert "\}\n" into out.
        Insert "\n" into out.
        Return out converted to text.
    Done.

    /// What a refusal calls the chase it reaches into: its name, when it has one.
    Bind text to chase-label, given (the node target):
        If target's kind is "VariableReference", return cast unquoted on (cast field-of on (target, 1)).
        Return "the series".
    Done.

    // ── Expressions ───────────────────────────────────────────────────────

    /// `item … of <chase>`, `the first of`, `the last of` — one character, as a text.
    Bind text or failure to c-chase-item unto emitter, given (the node target, the node index, the text at-line):
        Define chase-c as cast one's c-of on (target) or pass the failure off.
        Define label as cast chase-label on (target).
        If cast is-nothing on (index):
            Return "(\{ CufetChase* cf_ch = {chase-c}; cufet_chase_at(cf_ch, cufet_last_check(cf_ch->len, \"{label}\", {at-line})); \})".
        Done.
        Define index-c as cast one's c-of on (index) or pass the failure off.
        Return "(\{ CufetChase* cf_ch = {chase-c}; cufet_chase_at(cf_ch, cufet_idx_check(cufet_to_int({index-c}), cf_ch->len, \"{label}\", {at-line})); \})".
    Done.

    // ── Statements ────────────────────────────────────────────────────────

    /// `Insert <text or code point> into <chase>`, at the end, the start, or after a place.
    Bind void or failure to emit-chase-insert unto emitter, given (the node statement):
        Define target as cast field-of on (statement, 2).
        Define chase-c as cast one's c-of on (target) or pass the failure off.
        Define value as cast one's c-of on (cast field-of on (statement, 1)) or pass the failure off.
        Define value-kind as cast one's kind-of on (cast field-of on (statement, 1)) or pass the failure off.
        Define at-line as (cast field-of on (statement, 5))'s word.
        // The chase, then the value, then the place, as the interpreter works them out.
        Define operands as a series of node with (target, cast field-of on (statement, 1)).
        Define sides as a series of text with (chase-c, value).
        If (cast field-of on (statement, 4))'s word is not "true" and cast is-nothing on (cast field-of on (statement, 3)) is false:
            Insert cast field-of on (statement, 3) into operands.
            Define after-c as cast one's c-of on (cast field-of on (statement, 3)) or pass the failure off.
            Insert after-c into sides.
        Done.
        Define prefix as cast order-prefix on (operands, sides).
        Define bound as "{prefix}CufetChase* cf_ch = {item 1 of sides};".
        The value becomes item 2 of sides.
        Define at as "cf_ch->len".
        If (cast field-of on (statement, 4))'s word is "true", the at becomes "0".
        Otherwise if the number of sides is 3:
            The at becomes "(int)cufet_idx_check(cufet_to_int({item 3 of sides}), cf_ch->len, \"{cast chase-label on (target)}\", {at-line})".
        Done.
        If value-kind is "number":
            Cast one's line on ("\{ {bound} cufet_chase_insert_point(cf_ch, {at}, cufet_code_point({value}, {at-line})); \}").
            Return.
        Done.
        If value-kind is not "text", return a failure (cast not-built on ("inserting a {value-kind} into a chase")).
        // At the end, decoded straight onto it, as `cufet build` does. Anywhere else the text is
        // decoded apart first, to know how far to move what follows — a chase of its own, every time,
        // which at the end cost the compiled checker 19 million chases on one file.
        If at is "cf_ch->len":
            Cast one's line on ("\{ {bound} cufet_chase_append(cf_ch, {value}); \}").
            Return.
        Done.
        Cast one's line on ("\{ {bound} cufet_chase_insert(cf_ch, {at}, {value}); \}").
    Done.

    /// `Remove item … from`, `Remove the last from`, and `Remove "<character>" from` a chase.
    Bind void or failure to emit-chase-remove unto emitter, given (the node statement):
        Define target as cast field-of on (statement, 1).
        Define label as cast chase-label on (target).
        If cast is-nothing on (cast field-of on (statement, 2)):
            Define chase-c as cast one's c-of on (target) or pass the failure off.
            Cast one's line on ("cufet_chase_remove_at({chase-c}, -1, \"{label}\", {(cast field-of on (statement, 3))'s word});").
            Return.
        Done.
        // The chase first, then what goes, as the interpreter works them out.
        Define sides as cast one's c-fields-in-order on (statement, 1, 2) or pass the failure off.
        If statement's kind is "SeriesRemoveValueStatement":
            Cast one's line on (cast in-order-statement on (item 1 of sides, "cufet_chase_remove_value({item 2 of sides}, {item 3 of sides}, \"{label}\", {(cast field-of on (statement, 3))'s word});")).
            Return.
        Done.
        Cast one's line on (cast in-order-statement on (item 1 of sides, "cufet_chase_remove_at({item 2 of sides}, cufet_to_int({item 3 of sides}), \"{label}\", {(cast field-of on (statement, 3))'s word});")).
    Done.

    /// `The item … of <chase> becomes <character>.`
    Bind void or failure to emit-chase-set unto emitter, given (the node statement):
        Define target as cast field-of on (statement, 1).
        Define chase-c as cast one's c-of on (target) or pass the failure off.
        Define label as cast chase-label on (target).
        Define at-line as (cast field-of on (statement, 4))'s word.
        Define value as cast one's c-of on (cast field-of on (statement, 3)) or pass the failure off.
        // The chase, then the place, then the character, as the interpreter works them out.
        Define index as cast field-of on (statement, 2).
        Define operands as a series of node with (target, cast field-of on (statement, 3)).
        Define sides as a series of text with (chase-c, value).
        If cast is-nothing on (index) is false:
            Define index-c as cast one's c-of on (index) or pass the failure off.
            The operands becomes a series of node with (target, index, cast field-of on (statement, 3)).
            The sides becomes a series of text with (chase-c, index-c, value).
        Done.
        Define prefix as cast order-prefix on (operands, sides).
        Define placed-at as "cufet_last_check(cf_ch->len, \"{label}\", {at-line})".
        If the number of sides is 3:
            The placed-at becomes "cufet_idx_check(cufet_to_int({item 2 of sides}), cf_ch->len, \"{label}\", {at-line})".
        Done.
        Cast one's line on ("\{ {prefix}CufetChase* cf_ch = {item 1 of sides}; cufet_chase_set(cf_ch, (int){placed-at}, {item (the number of sides) of sides}, {at-line}); \}").
    Done.

    /// `For each <name> in <chase>` — each character, as a text. Changing the chase while it runs is
    /// refused before each pass and once more on the way out, as for a series.
    Bind void or failure to emit-chase-for-each unto emitter, given (the node statement):
        Define named as cast field-of on (statement, 1).
        Define name as "it".
        If cast is-nothing on (named) is false, the name becomes cast unquoted on (named).
        Define over as cast field-of on (statement, 2).
        Define label as "The chase".
        If over's kind is "VariableReference", the label becomes "'{cast unquoted on (cast field-of on (over, 1))}'".
        Define chase-c as cast one's c-of on (over) or pass the failure off.
        Cast one's line on ("\{").
        Define kept as cast one's kinds-kept.
        Define outer as one's indent.
        The one's indent becomes outer joined to "    ".
        Cast one's line on ("CufetChase* cf_each = {chase-c};").
        Cast one's line on ("int cf_each_n = cf_each->len;").
        Cast one's line on ("for (int cf_i = 0; ; cf_i++) \{").
        In one's kinds, the entry for name becomes "text".
        Cast one's declared-here on (name).
        In one's kinds, the entry for "%{name}" becomes "text".
        In one's kinds, the entry for "@{name}" becomes "".
        The one's indent becomes outer joined to "        ".
        Cast one's line on ("if (cf_each->len != cf_each_n) cufet_raise(cufet_msgf(\"{label} was modified during a for-each loop on line {(cast field-of on (statement, 4))'s word} — collect into a separate series, or use a While loop if you need to change it while looping.\"));").
        Cast one's line on ("if (cf_i >= cf_each_n) break;").
        Cast one's line on ("const char* {cast c-name on (name)} = cufet_chase_at(cf_each, cf_i + 1);").
        The one's indent becomes outer joined to "    ".
        Define loop-kept as cast one's entering-loop.
        Cast one's emit-block on (cast field-of on (statement, 3)) or pass the failure off.
        Cast one's leaving-loop on (loop-kept).
        Cast one's line on ("\}").
        The one's indent becomes outer.
        The one's kinds becomes kept.
        Cast one's line on ("\}").
    Done.
Done.
