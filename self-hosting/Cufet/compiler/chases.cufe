/*  Chases — `a chase`, `Insert … into` (text, or a number as a code point; at the end, the start, or
    after a place), `item … of`, `the number of`, setting and removing a character, `For each`,
    `converted to text`, and comparing two.

    ★ A chase is SHARED, as a series is: a pointer to code points, UTF-32 inside and UTF-8 at its
      edges, so `item n of` is a subscript. Its C — `CufetChase` and what works on it — is written
      into every program, used or not, as the series helpers are; it is the C `cufet build` writes
      for one, lifted from `CodeGenerator.Runtime.cs` by a script rather than retyped.

    ⚠ `sorted` waits, as it does for a series.
*/

Pull books on collections, and the c-language.
    /// The C every chase works through.
    Bind c-language axiom to c-chase-runtime:
        Return [
        typedef struct { int32_t* data; int len; int cap; } CufetChase;

        static CufetChase* cufet_chase_new(void) {
            CufetChase* c = (CufetChase*)cufet_arena_alloc(sizeof(CufetChase));
            c->len = 0; c->cap = 16;
            c->data = (int32_t*)cufet_arena_alloc(sizeof(int32_t) * (size_t)c->cap);
            return c;
        }

        static void cufet_chase_push(CufetChase* c, int32_t point) {
            if (c->len == c->cap) {
                int grown = c->cap * 2;
                int32_t* moved = (int32_t*)cufet_arena_alloc(sizeof(int32_t) * (size_t)grown);
                memcpy(moved, c->data, sizeof(int32_t) * (size_t)c->len);
                c->data = moved; c->cap = grown;
            }
            c->data[c->len++] = point;
        }

        /* Appends every character of a UTF-8 text. A malformed byte is taken as one character rather
           than rejected: the lexer only ever hands over well-formed text, and a buffer is the wrong
           place to discover otherwise. */
        static void cufet_chase_append(CufetChase* c, const char* text) {
            const unsigned char* p = (const unsigned char*)text;
            while (*p) {
                int32_t point; int extra;
                if      (*p < 0x80) { point = *p;        extra = 0; }
                else if ((*p & 0xE0) == 0xC0) { point = *p & 0x1F; extra = 1; }
                else if ((*p & 0xF0) == 0xE0) { point = *p & 0x0F; extra = 2; }
                else if ((*p & 0xF8) == 0xF0) { point = *p & 0x07; extra = 3; }
                else { point = *p; extra = 0; }
                p++;
                for (int i = 0; i < extra && (*p & 0xC0) == 0x80; i++) { point = (point << 6) | (*p & 0x3F); p++; }
                cufet_chase_push(c, point);
            }
        }

        /* How many bytes one code point needs in UTF-8. */
        static int cufet_utf8_width(int32_t point) {
            if (point < 0x80) return 1;
            if (point < 0x800) return 2;
            if (point < 0x10000) return 3;
            return 4;
        }

        static char* cufet_utf8_put(char* out, int32_t point) {
            if (point < 0x80) { *out++ = (char)point; return out; }
            if (point < 0x800) {
                *out++ = (char)(0xC0 | (point >> 6));
                *out++ = (char)(0x80 | (point & 0x3F));
                return out;
            }
            if (point < 0x10000) {
                *out++ = (char)(0xE0 | (point >> 12));
                *out++ = (char)(0x80 | ((point >> 6) & 0x3F));
                *out++ = (char)(0x80 | (point & 0x3F));
                return out;
            }
            *out++ = (char)(0xF0 | (point >> 18));
            *out++ = (char)(0x80 | ((point >> 12) & 0x3F));
            *out++ = (char)(0x80 | ((point >> 6) & 0x3F));
            *out++ = (char)(0x80 | (point & 0x3F));
            return out;
        }

        /* The explicit COPY `converted to text` makes. The buffer lives on, independent. */
        static const char* cufet_chase_text(CufetChase* c) {
            size_t need = 1;
            for (int i = 0; i < c->len; i++) need += (size_t)cufet_utf8_width(c->data[i]);
            char* out = (char*)cufet_arena_alloc(need);
            char* at = out;
            for (int i = 0; i < c->len; i++) at = cufet_utf8_put(at, c->data[i]);
            *at = 0;
            return out;
        }

        /* Printed as the COLLECTION it is — `(h, e, l, l, o)` — never as the text it will become. */
        /* Sets one position, and REFUSES a text that is not exactly one character.

           ⚠ A length check at run time rather than a type error, because a text's length is not known
           until it exists. The alternative — taking the first character and dropping the rest — is the
           silent resolution this language refuses everywhere else; setting one position to "abc" is a
           mistake, not an abbreviation. Insert is the operation that takes however many. */
        static void cufet_chase_set(CufetChase* c, int index1, const char* one, int line) {
            CufetChase* scratch = cufet_chase_new();
            cufet_chase_append(scratch, one);
            if (scratch->len != 1)
                cufet_raise(cufet_msgf(
                    "Setting one position needs exactly one character, and \"%s\" is %d. This happened on line %d.",
                    one, scratch->len, line));
            c->data[index1 - 1] = scratch->data[0];
        }

        /* Takes one character out and closes the gap. -1 means the last, matching the series form. */
        static void cufet_chase_remove_at(CufetChase* c, long long index1, const char* name, int line) {
            int at = (index1 < 0)
                ? (int)cufet_last_check(c->len, name, line)
                : (int)cufet_idx_check(index1, c->len, name, line);
            memmove(&c->data[at - 1], &c->data[at], sizeof(int32_t) * (size_t)(c->len - at));
            c->len--;
        }

        /* A number as a code point, or a failure naming which way it is not one. ⚠ The checker refuses a
           written-out bad value, so arriving here means the number was computed — and the wording matches
           the static message deliberately, so a reader sees one message either way. */
        static int32_t cufet_code_point(CufetDec point, int line) {
            /* Whole means no fractional part once trailing zeros are gone — `cufet_dec_strip` is what
               decides that everywhere else, so it decides it here too rather than a second rule. */
            if (cufet_dec_strip(point).scale != 0)
                cufet_raise(cufet_msgf("%s is not a code point, because it is not a whole number (line %d).",
                                       cufet_text_from_dec(point), line));
            long long n = cufet_to_int(point);
            if (n < 0 || n > 0x10FFFF)
                cufet_raise(cufet_msgf("%lld is outside the range of a code point — they run from 0 to U+10FFFF (line %d).",
                                       n, line));
            if (n >= 0xD800 && n <= 0xDFFF)
                cufet_raise(cufet_msgf("%lld is half of a character, not one — surrogates only mean anything in pairs (line %d).",
                                       n, line));
            return (int32_t)n;
        }

        /* One code point in, at a 0-based position. ⚠ `at` equal to the length appends. */
        static void cufet_chase_insert_point(CufetChase* c, int at, int32_t point) {
            int moved = c->len - at;
            cufet_chase_push(c, 0);
            memmove(&c->data[at + 1], &c->data[at], sizeof(int32_t) * (size_t)moved);
            c->data[at] = point;
        }

        /* Inserts every character of a text at a 0-based position, shifting what follows. ⚠ `at` equal to
           the length appends, which is what makes the plain form and the positional forms one helper. */
        static void cufet_chase_insert(CufetChase* c, int at, const char* text) {
            CufetChase* incoming = cufet_chase_new();
            cufet_chase_append(incoming, text);
            if (incoming->len == 0) return;

            int moved = c->len - at;
            for (int i = 0; i < incoming->len; i++) cufet_chase_push(c, 0);   /* grow, then shift */
            memmove(&c->data[at + incoming->len], &c->data[at], sizeof(int32_t) * (size_t)moved);
            memcpy(&c->data[at], incoming->data, sizeof(int32_t) * (size_t)incoming->len);
        }

        /* Takes the FIRST occurrence of one character out, by value. The one-character rule is the same
           one setting a position follows, and for the same reason: a text's length is not known until it
           exists, and keeping its first character would be the silent resolution this language refuses. */
        static void cufet_chase_remove_value(CufetChase* c, const char* one, const char* name, int line) {
            CufetChase* scratch = cufet_chase_new();
            cufet_chase_append(scratch, one);
            if (scratch->len != 1)
                cufet_raise(cufet_msgf(
                    "'Remove' from a chase takes exactly one character, and \"%s\" is %d. This happened on line %d.",
                    one, scratch->len, line));
            for (int i = 0; i < c->len; i++) {
                if (c->data[i] != scratch->data[0]) continue;
                memmove(&c->data[i], &c->data[i + 1], sizeof(int32_t) * (size_t)(c->len - i - 1));
                c->len--;
                return;
            }
            cufet_raise(cufet_msgf("Character not found in %s on line %d.", name, line));
        }

        /* A sorted COPY, by code point. ⚠ The unit is the point rather than the rendered character, which
           is what keeps this identical to the interpreter — it orders the same integers. */
        static CufetChase* cufet_chase_sorted(CufetChase* c, int reverse) {
            CufetChase* out = cufet_chase_new();
            for (int i = 0; i < c->len; i++) cufet_chase_push(out, c->data[i]);
            for (int a = 1; a < out->len; a++) {
                int32_t key = out->data[a];
                int j = a - 1;
                while (j >= 0 && (reverse ? out->data[j] < key : out->data[j] > key)) {
                    out->data[j + 1] = out->data[j];
                    j--;
                }
                out->data[j + 1] = key;
            }
            return out;
        }

        /* One character out, as the one-character TEXT the language calls a character. Four bytes plus a
           terminator is the most any code point needs. */
        static const char* cufet_chase_at(CufetChase* c, int index1) {
            char* out = (char*)cufet_arena_alloc(5);
            char* at = cufet_utf8_put(out, c->data[index1 - 1]);
            *at = 0;
            return out;
        }

        /* Structural, matching the interpreter: a buffer of the same characters is the same buffer. */
        static int cufet_chase_eq(CufetChase* a, CufetChase* b) {
            if (a == b) return 1;
            if (!a || !b || a->len != b->len) return 0;
            for (int i = 0; i < a->len; i++) if (a->data[i] != b->data[i]) return 0;
            return 1;
        }

        static const char* cufet_chase_show(CufetChase* c) {
            size_t need = 3;
            for (int i = 0; i < c->len; i++) need += (size_t)cufet_utf8_width(c->data[i]) + 2;
            char* out = (char*)cufet_arena_alloc(need);
            char* at = out;
            *at++ = 40;
            for (int i = 0; i < c->len; i++) {
                if (i > 0) { *at++ = 44; *at++ = 32; }
                at = cufet_utf8_put(at, c->data[i]);
            }
            *at++ = 41;
            *at = 0;
            return out;
        }
        ].
    Done.

    /// What a refusal calls the chase it reaches into: its name, when it has one.
    Bind text to chase-label, given (the node target):
        If target's kind is "VariableReference", return cast unquoted on (cast field-of on (target, 1)).
        Return "the series".
    Done.

    // ── Expressions ───────────────────────────────────────────────────────

    /// `item … of <chase>`, `the first of`, `the last of` — one character, as a text.
    Bind c-language axiom or failure to c-chase-item unto emitter, given (the node target, the node index, the number at-line):
        Define chase-c as cast one's c-of on (target) or pass the failure off.
        Define label as cast chase-label on (target).
        If cast is-nothing on (index):
            Define c-language last-item, given (the c-language axiom held, the text label, the number at-line),
                as [({ CufetChase* cf_ch = the held; cufet_chase_at(cf_ch, cufet_last_check(cf_ch->len, the label, the at-line)); })].
            Return last-item on (chase-c, label, at-line).
        Done.
        Define index-c as cast one's c-of on (index) or pass the failure off.
        Define c-language placed-item, given (the c-language axiom held, the c-language axiom index, the text label, the number at-line),
            as [({ CufetChase* cf_ch = the held; cufet_chase_at(cf_ch, cufet_idx_check(cufet_to_int(the index), cf_ch->len, the label, the at-line)); })].
        Return placed-item on (chase-c, index-c, label, at-line).
    Done.

    // ── Statements ────────────────────────────────────────────────────────

    /// `Insert <text or code point> into <chase>`, at the end, the start, or after a place.
    Bind void or failure to emit-chase-insert unto emitter, given (the node statement):
        Define target as cast field-of on (statement, 2).
        Define chase-c as cast one's c-of on (target) or pass the failure off.
        Define value as cast one's c-of on (cast field-of on (statement, 1)) or pass the failure off.
        Define value-kind as cast one's kind-of on (cast field-of on (statement, 1)) or pass the failure off.
        Define at-line as cast line-number on (cast field-of on (statement, 5)).
        // The chase, then the value, then the place, as the interpreter works them out.
        Define operands as a series of node with (target, cast field-of on (statement, 1)).
        Define sides as a series of c-language axiom with (chase-c, value).
        If (cast field-of on (statement, 4))'s word is not "true" and cast is-nothing on (cast field-of on (statement, 3)) is false:
            Insert cast field-of on (statement, 3) into operands.
            Define after-c as cast one's c-of on (cast field-of on (statement, 3)) or pass the failure off.
            Insert after-c into sides.
        Done.
        Define prefix as cast order-prefix on (operands, sides).
        Define c-language chase-bound, given (the c-language axiom prefix, the c-language axiom held), as [the prefix CufetChase* cf_ch = the held;].
        Define bound as chase-bound on (prefix, item 1 of sides).
        The value becomes item 2 of sides.
        Define c-language place-checked, given (the c-language axiom place, the text label, the number at-line),
            as [(int)cufet_idx_check(cufet_to_int(the place), cf_ch->len, the label, the at-line)].
        Define at-end as false.
        Define at as c-verbatim on ([0]).
        If (cast field-of on (statement, 4))'s word is not "true":
            If the number of sides is 3, the at becomes place-checked on (item 3 of sides, cast chase-label on (target), at-line).
            Otherwise:
                The at becomes c-verbatim on ([cf_ch->len]).
                The at-end becomes true.
            Done.
        Done.
        If value-kind is "number":
            Define c-language point-inserted, given (the c-language axiom bound, the c-language axiom at, the c-language axiom value, the number at-line),
                as [{ the bound cufet_chase_insert_point(cf_ch, the at, cufet_code_point(the value, the at-line)); }].
            Cast one's put on (point-inserted on (bound, at, value, at-line)).
            Return.
        Done.
        If value-kind is not "text", return a failure (cast not-built on ("inserting a {value-kind} into a chase")).
        // At the end, decoded straight onto it, as `cufet build` does. Anywhere else the text is
        // decoded apart first, to know how far to move what follows — a chase of its own, every time,
        // which at the end cost the compiled checker 19 million chases on one file.
        If at-end:
            Define c-language text-appended, given (the c-language axiom bound, the c-language axiom value),
                as [{ the bound cufet_chase_append(cf_ch, the value); }].
            Cast one's put on (text-appended on (bound, value)).
            Return.
        Done.
        Define c-language text-inserted, given (the c-language axiom bound, the c-language axiom at, the c-language axiom value),
            as [{ the bound cufet_chase_insert(cf_ch, the at, the value); }].
        Cast one's put on (text-inserted on (bound, at, value)).
    Done.

    /// `Remove item … from`, `Remove the last from`, and `Remove "<character>" from` a chase.
    Bind void or failure to emit-chase-remove unto emitter, given (the node statement):
        Define target as cast field-of on (statement, 1).
        Define label as cast chase-label on (target).
        If cast is-nothing on (cast field-of on (statement, 2)):
            Define chase-c as cast one's c-of on (target) or pass the failure off.
            Define c-language cufet-chase-remove-form, given (the c-language axiom chase-c, the text message, the number word),
                as [cufet_chase_remove_at(the chase-c, -1, the message, the word);].
            Cast one's put on (cufet-chase-remove-form on (chase-c, "{label}", cast line-number on (cast field-of on (statement, 3)))).
            Return.
        Done.
        // The chase first, then what goes, as the interpreter works them out.
        Define sides as cast one's c-fields-in-order on (statement, 1, 2) or pass the failure off.
        If statement's kind is "SeriesRemoveValueStatement":
            Define c-language value-removed, given (the c-language axiom held, the c-language axiom value, the text label, the number at-line),
                as [cufet_chase_remove_value(the held, the value, the label, the at-line);].
            Cast one's put on (cast in-order-statement on (item 1 of sides, value-removed on (item 2 of sides, item 3 of sides, label, cast line-number on (cast field-of on (statement, 3))))).
            Return.
        Done.
        Define c-language place-removed, given (the c-language axiom held, the c-language axiom place, the text label, the number at-line),
            as [cufet_chase_remove_at(the held, cufet_to_int(the place), the label, the at-line);].
        Cast one's put on (cast in-order-statement on (item 1 of sides, place-removed on (item 2 of sides, item 3 of sides, label, cast line-number on (cast field-of on (statement, 3))))).
    Done.

    /// `The item … of <chase> becomes <character>.`
    Bind void or failure to emit-chase-set unto emitter, given (the node statement):
        Define target as cast field-of on (statement, 1).
        Define chase-c as cast one's c-of on (target) or pass the failure off.
        Define label as cast chase-label on (target).
        Define at-line as cast line-number on (cast field-of on (statement, 4)).
        Define value as cast one's c-of on (cast field-of on (statement, 3)) or pass the failure off.
        // The chase, then the place, then the character, as the interpreter works them out.
        Define index as cast field-of on (statement, 2).
        Define operands as a series of node with (target, cast field-of on (statement, 3)).
        Define sides as a series of c-language axiom with (chase-c, value).
        If cast is-nothing on (index) is false:
            Define index-c as cast one's c-of on (index) or pass the failure off.
            The operands becomes a series of node with (target, index, cast field-of on (statement, 3)).
            The sides becomes a series of c-language axiom with (chase-c, index-c, value).
        Done.
        Define prefix as cast order-prefix on (operands, sides).
        Define c-language last-placed, given (the text label, the number at-line), as [cufet_last_check(cf_ch->len, the label, the at-line)].
        Define c-language index-placed, given (the c-language axiom place, the text label, the number at-line),
            as [cufet_idx_check(cufet_to_int(the place), cf_ch->len, the label, the at-line)].
        Define placed-at as last-placed on (label, at-line).
        If the number of sides is 3, the placed-at becomes index-placed on (item 2 of sides, label, at-line).
        Define c-language character-set, given (the c-language axiom prefix, the c-language axiom held, the c-language axiom placed-at, the c-language axiom value, the number at-line),
            as [{ the prefix CufetChase* cf_ch = the held; cufet_chase_set(cf_ch, (int)the placed-at, the value, the at-line); }].
        Cast one's put on (character-set on (prefix, item 1 of sides, placed-at, item (the number of sides) of sides, at-line)).
    Done.

    /// `For each <name> in <chase>` — each character, as a text. Changing the chase while it runs is
    /// refused before each pass and once more on the way out, as for a series.
    Bind void or failure to emit-chase-for-each unto emitter, given (the node statement):
        Define named as cast field-of on (statement, 1).
        Define name as "it".
        If cast is-nothing on (named) is false, the name becomes cast unquoted on (named).
        Define over as cast field-of on (statement, 2).
        Define label as "The chase".
        If over's kind is "VariableReference", the label becomes "'{cast unquoted on (cast field-of on (over, 1))}'".
        Define chase-c as cast one's c-of on (over) or pass the failure off.
        Cast one's put on ([{]).
        Define kept as cast one's kinds-kept.
        Define outer as one's indent.
        The one's indent becomes outer joined to "    ".
        Define c-language cufetchase-each-chase-form, given (the c-language axiom chase-c),
            as [CufetChase* cf_each = the chase-c;].
        Cast one's put on (cufetchase-each-chase-form on (chase-c)).
        Cast one's put on ([int cf_each_n = cf_each->len;]).
        Cast one's put on ([for (int cf_i = 0; ; cf_i++) {]).
        In one's kinds, the entry for name becomes "text".
        Cast one's declared-here on (name).
        In one's kinds, the entry for "%{name}" becomes "text".
        In one's kinds, the entry for "@{name}" becomes "".
        The one's indent becomes outer joined to "        ".
        Define c-language each-len-each-form, given (the text message),
            as [if (cf_each->len != cf_each_n) cufet_raise(cufet_msgf(the message));].
        Cast one's put on (each-len-each-form on ("{label} was modified during a for-each loop on line {(cast field-of on (statement, 4))'s word} — collect into a separate series, or use a While loop if you need to change it while looping.")).
        Cast one's put on ([if (cf_i >= cf_each_n) break;]).
        Define c-language name-cufet-chase-form, given (the term c-name),
            as [const char* the c-name = cufet_chase_at(cf_each, cf_i + 1);].
        Cast one's put on (name-cufet-chase-form on (cast c-name on (name))).
        The one's indent becomes outer joined to "    ".
        Define loop-kept as cast one's entering-loop.
        Cast one's emit-block on (cast field-of on (statement, 3)) or pass the failure off.
        Cast one's leaving-loop on (loop-kept).
        Cast one's put on ([}]).
        The one's indent becomes outer.
        The one's kinds becomes kept.
        Cast one's put on ([}]).
    Done.
Done.
